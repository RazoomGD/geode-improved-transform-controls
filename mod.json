{
	"geode": "4.5.0",
	"gd": {
		"win": "2.2074",
		"android": "2.2074",
		"mac": "2.2074",
		"ios": "2.2074"
	},

	"id": "razoom.improved_transform_controls",
	"name": "Improved Transform Controls",
	"version": "v1.1.0",
	"developer": "RaZooM",
	"description": "Adds useful options to transform controls",
	"tags": ["editor", "utility"],

	"links": {
		"source": "https://github.com/RazoomGD/geode-improved-transform-controls",
		"community": "https://discord.gg/wcWvtKHP8n"
	},

	"resources": {
		"spritesheets": {
			"ITCSpritesheet": [
				"resources/*.png"
			]
		}
	},

	"settings": {
		"t1": {
			"type": "title",
			"name": "Options"
		},
		"button-scale": {
			"type": "float",
			"default": 1.0,
			"name": "Menu scale",
			"description": "Scale of the interface buttons",
			"max": 2.0,
			"min": 0.2,
			"control": {
				"big-arrows": false,
				"arrows": true,
				"arrow-step": 0.1,
				"input": true,
				"slider": true,
				"slider-step": 0.1
			}
		},
		"no-freerot":{
			"type": "bool",
			"default": false,
			"name": "'FreeRot' always enabled",
			"description": "This option makes Free Rotation UI element always visible and hides the 'FreeRot' button \n(enable this if you this if you think that 4 buttons is too much for that menu)"
		},
		"t2": {
			"type": "title",
			"name": "Interface"
		},
		"show-interface": {
			"type": "string",
			"name": "Show transform rectangle",
			"description": "Show the rectangle around selected objects during the transform",
			"default": "3: on change",
			"one-of": ["1: never", "2: always", "3: on change"]
		},
		"interface-color": {
			"type": "rgba",
			"name": "Transform rectangle color",
			"default": [255, 255, 0, 255]
		}
	}
}
